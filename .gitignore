# Secrets. Never commit one. If you do, deleting it in a later commit undoes
# nothing, because the value stays in the history, and the final project's
# forfeiture rule counts the history.
.env
*.pem
service-account*.json

# Bulk data stays out. Trip files are gigabytes and they already live in the
# bucket. We keep code in here, plus the small fixtures under data/ that the
# tests need, and the two negations below are what keep data/ committable.
*.parquet
!data/
!data/**

# Notebook checkpoints and tool caches
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environments and editors
.venv/
venv/
.vscode/
.DS_Store
